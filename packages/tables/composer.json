{
    "name": "invue/tables",
    "description": "Native Vue 3 data table components for the Invue framework, wired to Eloquent via Inertia partial reloads.",
    "keywords": ["laravel", "inertia", "vue", "tables", "invue"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "invue/core": "self.version"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Invue\\Tables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Invue\\Tables\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Invue\\Tables\\TablesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
