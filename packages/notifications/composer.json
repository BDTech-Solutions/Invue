{
    "name": "invue/notifications",
    "description": "Ephemeral toast notifications for the Invue framework: a PHP fluent builder (title/body/icon/color, flashed for the next request) rendered by a registry-swappable Vue toast stack.",
    "keywords": ["laravel", "inertia", "vue", "notifications", "invue"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "invue/core": "self.version"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Invue\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Invue\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Invue\\Notifications\\NotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
