{
    "name": "invue/actions",
    "description": "The shared 'button that does something' primitive for the Invue framework — a link/button with an optional confirmation modal, plus a dropdown group, reused by invue/tables (row/bulk actions) and any other package or app that needs a confirmable action.",
    "keywords": ["laravel", "inertia", "vue", "actions", "invue"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "invue/core": "self.version"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Invue\\Actions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Invue\\Actions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Invue\\Actions\\ActionsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
